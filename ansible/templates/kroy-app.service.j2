[Unit]
Description=Kroy Vyaz application
After=network.target postgresql.service

[Service]
Type=simple
User={{ kroy_user }}
Group={{ kroy_group | default(kroy_user) }}
WorkingDirectory={{ kroy_root }}
EnvironmentFile=-{{ kroy_root }}/.env
ExecStart={{ kroy_yarn_binary | default('/usr/bin/yarn') }} vyaz:serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
