# Managed by Ansible. TLS is intentionally configured separately.
server {
    listen 80;
    server_name {% for domain in proxy_domains %}{{ domain }} {% endfor %};

    {% if tls_enabled %}return 301 https://$host$request_uri;{% else %}

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    {% endif %}
}
{% if tls_enabled %}
server {
    listen 443 ssl;
    server_name {% for domain in proxy_domains %}{{ domain }} {% endfor %};
    ssl_certificate /etc/letsencrypt/live/oysite.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oysite.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
{% endif %}
