# Temporary static landing for oysite.ru; managed by Ansible.
server {
    listen 80;
    server_name oysite.ru;

    {% if tls_enabled %}return 301 https://$host$request_uri;{% else %}

    root /var/www/oysite;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    {% endif %}
}
{% if tls_enabled %}
server {
    listen 443 ssl;
    server_name oysite.ru;
    ssl_certificate /etc/letsencrypt/live/oysite.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oysite.ru/privkey.pem;

    root /var/www/oysite;
    index index.html;
    location / {
        try_files $uri $uri/ =404;
    }
}
{% endif %}
