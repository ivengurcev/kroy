# Standalone/production only; Compose supplies its own db:5432 connection.
DATABASE_URL=postgres://kroy:kroy-local@127.0.0.1:5432/kroy
AUTH_SECRET=
# Optional future integration code assigned by Prodamus. Leave empty for independent shops.
PRODAMUS_SYS=
# Stable server-only secret (32+ characters) for AES-GCM encryption of merchant keys.
# If omitted, AUTH_SECRET is used. Back up this value; do not rotate without re-encrypting keys.
PAYMENT_ENCRYPTION_KEY=
# Compose uses this only inside the development network.
KROY_NGINX_CONTROL_URL=
NGINX_LISTEN=127.0.0.1:8080
NGINX_CONFIG_DIR=dist/kroy/nginx
NGINX_SITES_ROOT=dist/sites
NGINX_UPSTREAM=127.0.0.1:3000
