{
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  },
  "devDependencies": {
    "@yarnpkg/sdks": "^3.3.1",
    "comment-parser": "^1.4.9",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "parts:generate": "node scripts/discoverParts.mjs",
    "demo": "yarn parts:generate && yarn esbuild ./scripts/renderDemo.jsx --bundle --packages=external --platform=node --format=cjs --jsx=automatic --outfile=generated/demo.cjs && yarn node generated/demo.cjs",
    "editor:demo": "yarn parts:generate && yarn esbuild ./editor/main.jsx --bundle --platform=browser --format=iife --jsx=automatic --outfile=generated/editor.js"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
