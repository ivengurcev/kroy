{
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "vyaz"
  ],
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "comment-parser": "^1.4.9",
    "dbmate": "2.36.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "bootstrap": "ansible-playbook -i infra/ansible/inventory infra/ansible/kroy-bootstrap.yml -K",
    "help": "bun scripts/help.mjs",
    "kroy:help": "bun scripts/help.mjs",
    "remote": "bun scripts/remote.mjs",
    "deploy": "bun scripts/deploy.mjs",
    "db": "dbmate up",
    "db:migrate": "dbmate up",
    "db:status": "dbmate status",
    "db:rollback": "bun scripts/dbRollback.mjs",
    "db:seed": "bun db/seed.mjs",
    "user:create": "bun scripts/createUser.mjs",
    "parts:generate": "bun scripts/discoverParts.mjs",
    "dev": "bun scripts/devCompose.mjs up",
    "dev:bg": "bun scripts/devCompose.mjs background",
    "dev:down": "bun scripts/devCompose.mjs down",
    "dev:logs": "bun scripts/devCompose.mjs logs",
    "dev:status": "bun scripts/devCompose.mjs status",
    "dev:run": "bun scripts/devCompose.mjs run",
    "dev:restart": "bun scripts/devCompose.mjs restart",
    "dev:rebuild": "bun scripts/devCompose.mjs rebuild",
    "site:create": "bun scripts/createSite.mjs",
    "site:domain:add": "bun scripts/addSiteDomain.mjs",
    "site:domain:remove": "bun scripts/removeSiteDomain.mjs",
    "site:user:add": "bun scripts/addSiteUser.mjs",
    "site:list": "bun scripts/listSites.mjs",
    "site:info": "bun scripts/getSiteInfo.mjs",
    "site:build": "bun scripts/buildSite.mjs",
    "site:publish": "bun scripts/publishSite.mjs",
    "site:releases": "bun scripts/listSiteReleases.mjs",
    "site:rollback": "bun scripts/rollbackSite.mjs",
    "demo": "bun run site:build demo",
    "preview": "bun run preview:start",
    "preview:init": "NODE_ENV=development bun scripts/initNginx.mjs",
    "preview:start": "NODE_ENV=development bun scripts/startNginx.mjs",
    "preview:validate": "bun scripts/nginxControl.mjs validate",
    "preview:reload": "bun scripts/nginxControl.mjs reload",
    "nginx:init": "bun scripts/initNginx.mjs",
    "nginx:validate": "bun scripts/nginxControl.mjs validate",
    "build": "bun run vyaz:build",
    "serve": "bun run vyaz:serve",
    "vyaz:build": "bun run parts:generate && bun server.mjs --build-public --build-ssr --minify",
    "vyaz:serve": "bun server.mjs --serve"
  },
  "dependencies": {
    "@lexical/history": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@vyaz/core": "workspace:*",
    "leaflet": "1.9.4",
    "lexical": "^0.53.0",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.34.3"
  }
}
