{
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  },
  "devDependencies": {
    "@yarnpkg/sdks": "^3.3.1",
    "comment-parser": "^1.4.9",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "parts:generate": "node scripts/discoverParts.mjs",
    "site:parts": "node scripts/generateSiteParts.mjs",
    "demo": "yarn parts:generate && yarn esbuild ./scripts/renderDemo.jsx --bundle --packages=external --platform=node --format=cjs --jsx=automatic --outfile=generated/demo.cjs && yarn node generated/demo.cjs",
    "editor:demo": "yarn site:parts && yarn esbuild ./editor/main.jsx --bundle --platform=browser --format=iife --jsx=automatic --outfile=generated/editor.js",
    "vyaz:build": "yarn parts:generate && yarn node server.mjs --build-public --build-ssr",
    "vyaz:serve": "yarn node server.mjs --serve"
  },
  "dependencies": {
    "@vyaz/core": "portal:../vyaz",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
