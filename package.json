{
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@yarnpkg/sdks": "^3.3.1",
    "comment-parser": "^1.4.9",
    "dbmate": "2.36.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "bootstrap": "ansible-playbook -i infra/ansible/inventory infra/ansible/kroy-bootstrap.yml -K",
    "help": "node scripts/help.mjs",
    "kroy:help": "node scripts/help.mjs",
    "remote": "node scripts/remote.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db": "dbmate up",
    "db:migrate": "dbmate up",
    "db:status": "dbmate status",
    "db:rollback": "node scripts/dbRollback.mjs",
    "db:seed": "yarn node --env-file-if-exists=.env db/seed.mjs",
    "user:create": "yarn node --env-file-if-exists=.env scripts/createUser.mjs",
    "parts:generate": "node scripts/discoverParts.mjs",
    "dev": "node scripts/devCompose.mjs up",
    "dev:bg": "node scripts/devCompose.mjs background",
    "dev:down": "node scripts/devCompose.mjs down",
    "dev:logs": "node scripts/devCompose.mjs logs",
    "dev:status": "node scripts/devCompose.mjs status",
    "dev:run": "node scripts/devCompose.mjs run",
    "dev:restart": "node scripts/devCompose.mjs restart",
    "dev:rebuild": "node scripts/devCompose.mjs rebuild",
    "site:create": "yarn node --env-file-if-exists=.env scripts/createSite.mjs",
    "site:domain:add": "yarn node --env-file-if-exists=.env scripts/addSiteDomain.mjs",
    "site:domain:remove": "yarn node --env-file-if-exists=.env scripts/removeSiteDomain.mjs",
    "site:user:add": "yarn node --env-file-if-exists=.env scripts/addSiteUser.mjs",
    "site:list": "yarn node --env-file-if-exists=.env scripts/listSites.mjs",
    "site:info": "yarn node --env-file-if-exists=.env scripts/getSiteInfo.mjs",
    "site:build": "yarn node --env-file-if-exists=.env scripts/buildSite.mjs",
    "site:publish": "yarn node --env-file-if-exists=.env scripts/publishSite.mjs",
    "site:releases": "yarn node scripts/listSiteReleases.mjs",
    "site:rollback": "yarn node --env-file-if-exists=.env scripts/rollbackSite.mjs",
    "demo": "yarn site:build demo",
    "preview": "yarn preview:start",
    "preview:init": "NODE_ENV=development yarn node --env-file-if-exists=.env scripts/initNginx.mjs",
    "preview:start": "NODE_ENV=development yarn node --env-file-if-exists=.env scripts/startNginx.mjs",
    "preview:validate": "yarn node --env-file-if-exists=.env scripts/nginxControl.mjs validate",
    "preview:reload": "yarn node --env-file-if-exists=.env scripts/nginxControl.mjs reload",
    "nginx:init": "node scripts/initNginx.mjs",
    "nginx:validate": "node scripts/nginxControl.mjs validate",
    "build": "yarn vyaz:build",
    "serve": "yarn vyaz:serve",
    "vyaz:build": "yarn parts:generate && yarn node --env-file-if-exists=.env server.mjs --build-public --build-ssr --minify",
    "vyaz:serve": "yarn node --env-file-if-exists=.env server.mjs --serve"
  },
  "dependencies": {
    "@lexical/history": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@vyaz/core": "portal:./vyaz",
    "leaflet": "1.9.4",
    "lexical": "^0.53.0",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.34.3"
  }
}
