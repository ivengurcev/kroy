{
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  },
  "devDependencies": {
    "@yarnpkg/sdks": "^3.3.1",
    "comment-parser": "^1.4.9",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "db:seed": "yarn node --env-file=.env db/seed.mjs",
    "parts:generate": "node scripts/discoverParts.mjs",
    "site:build": "yarn node --env-file=.env scripts/buildSite.mjs",
    "demo": "yarn site:build demo",
    "vyaz:build": "yarn parts:generate && yarn node --env-file=.env server.mjs --build-public --build-ssr",
    "vyaz:serve": "yarn node --env-file=.env server.mjs --serve"
  },
  "dependencies": {
    "@vyaz/core": "portal:../vyaz",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
