{
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "resolutions": {
    "@yarnpkg/core": "4.9.1"
  },
  "devDependencies": {
    "@yarnpkg/sdks": "^3.3.1",
    "comment-parser": "^1.4.9",
    "dbmate": "2.36.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "help": "node scripts/help.mjs",
    "kroy:help": "node scripts/help.mjs",
    "db": "dbmate up",
    "db:migrate": "dbmate up",
    "db:status": "dbmate status",
    "db:rollback": "dbmate rollback",
    "db:seed": "yarn node --env-file=.env db/seed.mjs",
    "user:create": "yarn node --env-file=.env scripts/createUser.mjs",
    "parts:generate": "node scripts/discoverParts.mjs",
    "site:create": "yarn node --env-file=.env scripts/createSite.mjs",
    "site:domain:add": "yarn node --env-file=.env scripts/addSiteDomain.mjs",
    "site:domain:remove": "yarn node --env-file=.env scripts/removeSiteDomain.mjs",
    "site:user:add": "yarn node --env-file=.env scripts/addSiteUser.mjs",
    "site:list": "yarn node --env-file=.env scripts/listSites.mjs",
    "site:info": "yarn node --env-file=.env scripts/getSiteInfo.mjs",
    "site:build": "yarn node --env-file=.env scripts/buildSite.mjs",
    "site:publish": "yarn node --env-file=.env scripts/publishSite.mjs",
    "site:deploy": "node scripts/deploySite.mjs",
    "site:releases": "yarn node scripts/listSiteReleases.mjs",
    "site:rollback": "yarn node --env-file=.env scripts/rollbackSite.mjs",
    "demo": "yarn site:build demo",
    "preview": "yarn preview:start",
    "preview:init": "yarn node --env-file=.env scripts/initNginx.mjs",
    "preview:start": "yarn node --env-file=.env scripts/startNginx.mjs",
    "preview:validate": "yarn node --env-file=.env scripts/nginxControl.mjs validate",
    "preview:reload": "yarn node --env-file=.env scripts/nginxControl.mjs reload",
    "vyaz:build": "yarn parts:generate && yarn node --env-file=.env server.mjs --build-public --build-ssr",
    "vyaz:serve": "yarn node --env-file=.env server.mjs --serve"
  },
  "dependencies": {
    "@vyaz/core": "portal:./vyaz",
    "pg": "^8.23.1",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
