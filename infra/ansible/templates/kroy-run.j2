#!{{ kroy_bun_binary | default('/usr/local/bin/bun') }}
const { spawn, spawnSync } = require('node:child_process');
const { readFileSync } = require('node:fs');
const { dirname, join } = require('node:path');

const ROOT = '{{ kroy_root }}';
const BUN = '{{ kroy_bun_binary | default("/usr/local/bin/bun") }}';
const BLOCKED_SCRIPTS = new Set(['remote', 'deploy', 'site:deploy']);
const [script, ...args] = process.argv.slice(2);

if (!script || !/^[a-z0-9][a-z0-9:-]*$/.test(script) || BLOCKED_SCRIPTS.has(script)) {
    console.error('Unknown or forbidden Kroy script');
    process.exit(2);
}

if (script === 'deps:install') {
    if (args.length) {
        console.error('deps:install does not accept arguments');
        process.exit(2);
    }
    try {
        const install = spawnSync(BUN, ['install', '--frozen-lockfile'], {
            cwd: ROOT, stdio: 'inherit',
        });
        process.exit(install.status ?? 1);
    } catch (error) {
        console.error(`Cannot install Kroy dependencies: ${error.message}`);
        process.exit(1);
    }
}

if (script === 'runtime:verify') {
    if (args.length) {
        console.error('runtime:verify does not accept arguments');
        process.exit(2);
    }
    const result = spawnSync(BUN, ['--no-install', '-e', 'await import("@vyaz/core/createApp.mjs")'], {
        cwd: ROOT,
        stdio: 'inherit',
    });
    process.exit(result.status ?? 1);
}

let scripts;
try {
    scripts = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8')).scripts || {};
} catch (error) {
    console.error(`Cannot read package.json: ${error.message}`);
    process.exit(2);
}

if (typeof scripts[script] !== 'string') {
    console.error(`Unknown Kroy script: ${script}`);
    process.exit(2);
}

const child = spawn(BUN, ['run', script, ...args], {
    cwd: ROOT,
    env: {
        ...process.env,
        PATH: `${dirname(BUN)}:/usr/local/bin:${process.env.PATH || ''}`,
    },
    stdio: 'inherit',
});

child.on('error', (error) => {
    console.error(`Cannot start ${script}: ${error.message}`);
    process.exitCode = 1;
});

child.on('exit', (code, signal) => {
    if (signal) process.kill(process.pid, signal);
    else process.exitCode = code ?? 1;
});
