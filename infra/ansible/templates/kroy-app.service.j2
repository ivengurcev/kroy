[Unit]
Description=Kroy Vyaz application
After=network.target postgresql.service

[Service]
Type=simple
User={{ kroy_user }}
Group={{ kroy_group | default(kroy_user) }}
WorkingDirectory={{ kroy_root }}
EnvironmentFile=-{{ kroy_root }}/.env
{% if kroy_runtime | default('node') == 'bun' %}
ExecStart={{ kroy_bun_binary | default('/usr/local/bin/bun') }} --no-install {{ kroy_root }}/server.mjs --serve
{% else %}
ExecStart={{ kroy_node_binary | default('/usr/bin/node') }} {{ kroy_yarn_release | default(kroy_root ~ '/.yarn/releases/yarn-4.18.1.cjs') }} vyaz:serve
{% endif %}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
